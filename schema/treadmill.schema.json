{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "treadmill.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "make",
    "model",
    "fitOscData",
    "vrtiData",
    "source",
    "features",
    "sharedNotes"
  ],
  "properties": {
    "id": { "type": "string" },
    "make": { "type": "string" },
    "model": { "type": "string" },
    "fitOscData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver"],
      "properties": {
        "driver": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["GENERIC", "WALKINGPAD"]
          },
          "minItems": 0,
          "uniqueItems": true,
          "description": "FitOSC driver options for this treadmill. Use an empty array when unsupported."
        }
      }
    },

    "vrtiData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experimental", "driver"],
      "properties": {
        "experimental": {
          "type": "boolean",
          "description": "Whether VRTI support relies on an experimental driver"
        },
        "driver": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "FTMS",
              "KINGSMITH_FE00",
              "KINGSMITH_1234",
              "PITPAT_FBA0",
              "FTMS_UREVO_HYBRID",
              "FTMS_KINGSMITH_G15"
            ]
          },
          "minItems": 0,
          "uniqueItems": true,
          "description": "VRTI driver options for this treadmill. Use an empty array when unsupported."
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "VRTI-specific notes that should not be shared across apps"
        }
      }
    },

    "weight": {
      "type": "object",
      "required": ["maxUser", "unit"],
      "additionalProperties": false,
      "properties": {
        "maxUser": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "enum": ["kg", "lb"] }
      }
    },

    "source": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },

    "features": {
      "$ref": "features.schema.json"
    },

    "vendorApps": {
      "type": "array",
      "description": "Manufacturer companion apps",
      "items": {
        "type": "object",
        "required": ["name", "supported"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "enum": ["URevo", "Kinomap", "Zwift", "KSFit", "FitShow", "PitPat"],
            "description": "Vendor app name"
          },
          "supported": {
            "type": "boolean",
            "description": "Whether this treadmill works with the vendor app"
          },
          "notes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Additional notes about vendor app compatibility"
          }
        }
      }
    },

    "sharedNotes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
